# ── Serveur ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:4200

# ── MongoDB ─────────────────────────────────────────────
# Atlas : mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?appName=Popote
# Local (docker-compose) : mongodb://mongo:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bouffe

# ── Authentification ────────────────────────────────────
# Secret de signature des access tokens (≥ 32 octets aléatoires) : openssl rand -hex 48
JWT_ACCESS_SECRET=change-me
# Durée de vie de l'access token (secondes) et du refresh token (jours)
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
# true derrière HTTPS (production)
COOKIE_SECURE=false
# Création de comptes : ouverte (true), fermée (false), ou sur invitation si SIGNUP_CODE est renseigné
# (8 caractères au moins ; lien d'inscription : /inscription?code=<le code>)
ALLOW_SIGNUP=true
SIGNUP_CODE=
# Nombre de reverse proxies devant l'API (1 : nginx seul ; 2 : Traefik + nginx avec Dokploy)
TRUST_PROXY=1

# ── Intégrations (toutes facultatives) ──────────────────
# Base produit externe pour les codes-barres (Open Food Facts, licence ODbL)
OFF_ENABLED=true
OFF_USER_AGENT=Popote/0.1 (application personnelle)
# Fournisseur magasin : manual (défaut) | mock (données d'EXEMPLE, dev uniquement)
RETAIL_PROVIDER=manual

# ── Notifications push (facultatif) ─────────────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Compte de démonstration créé par `npm run seed` ─────
DEMO_EMAIL=demo@bouffe.local
DEMO_PASSWORD=change-me-too
