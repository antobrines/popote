# Variables à coller dans Dokploy : service Compose → onglet « Environment ».
# (Dokploy les écrit dans un fichier .env à côté de docker-compose.dokploy.yml.)

# ── Obligatoires ────────────────────────────────────────

# Domaine public, sans https:// — le même que dans l'onglet « Domains ».
APP_DOMAIN=popote.abrines.fr

# MongoDB. Pour garder tes données actuelles : la même URI que dans apps/api/.env sur ta machine.
# Sur Atlas, autorise l'adresse IP du serveur dans « Network Access ».
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?appName=Popote
MONGODB_DB=bouffe

# Secret de signature des sessions, propre à la production : openssl rand -hex 48
JWT_ACCESS_SECRET=

# ── Accès ───────────────────────────────────────────────

# false : personne ne peut créer de compte, seuls ceux déjà en base se connectent.
# Passe à true le temps de créer un compte (toi, un proche), puis reviens à false et redéploie.
ALLOW_SIGNUP=false

# true pour exposer la documentation de l'API sur /api/docs.
API_DOCS=false

# ── Notifications push (facultatif) ─────────────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@abrines.fr

# ── Rarement utile ──────────────────────────────────────
# Nombre de proxies devant l'API. 2 = Traefik + nginx (cas normal avec Dokploy).
# 3 si le domaine passe en plus par le proxy Cloudflare (nuage orange).
# TRUST_PROXY=2
# Désactiver l'identification des codes-barres par Open Food Facts.
# OFF_ENABLED=true
