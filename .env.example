# Variables de docker-compose.yml (essai local) — copier en .env à la racine.
# Pour Dokploy, le modèle est dokploy.env.example.
# (En développement sans Docker, c'est apps/api/.env qui est lu : voir apps/api/.env.example.)

# Secret de signature des access tokens : openssl rand -hex 48
JWT_ACCESS_SECRET=

# MongoDB. Laisser vide pour le MongoDB local du profil « local-db »,
# ou renseigner une URI Atlas : mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?appName=Popote
MONGODB_URI=
MONGODB_DB=bouffe

# URL publique de l'application et port d'écoute local
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# true quand l'application est servie en HTTPS (obligatoire en production)
COOKIE_SECURE=false

# Notifications push (facultatif) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Compte de démonstration créé par le seed (facultatif)
DEMO_EMAIL=demo@bouffe.local
DEMO_PASSWORD=
